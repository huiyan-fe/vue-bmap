{
  "name": "@baidumap/vue-bmap",
  "version": "1.0.0",
  "description": "Vue 3 components for Baidu Map JSAPI",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "examples": "vite --config examples/vite.config.ts",
    "test:manual": "vite --config test/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@baidumap/jsapi-loader": "^1.0.0"
  },
  "devDependencies": {
    "@baidumap/jsapi-v4-types": "^4.0.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-vue": "^5.0.0",
    "jsdom": "^25.0.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^2.1.9",
    "vue": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiyan-fe/vue-bmap.git"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "baidu",
    "map",
    "bmap",
    "bmapgl"
  ]
}
